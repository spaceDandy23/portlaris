{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/",
      "dest": "https://carlos-creative-portfolio.carlospolarislubrica.chatgpt.site/"
    },
    {
      "src": "/assets/(.*)",
      "dest": "https://carlos-creative-portfolio.carlospolarislubrica.chatgpt.site/assets/$1"
    },
    {
      "src": "/work/(.*)",
      "dest": "https://carlos-creative-portfolio.carlospolarislubrica.chatgpt.site/work/$1"
    },
    {
      "src": "/fonts/(.*)",
      "dest": "https://carlos-creative-portfolio.carlospolarislubrica.chatgpt.site/fonts/$1"
    },
    {
      "src": "/favicon.svg",
      "dest": "https://carlos-creative-portfolio.carlospolarislubrica.chatgpt.site/favicon.svg"
    },
    {
      "src": "/api/content",
      "dest": "https://carlos-creative-portfolio.carlospolarislubrica.chatgpt.site/api/content"
    }
  ]
}
